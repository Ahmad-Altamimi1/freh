# Migration files must keep LF line endings in the working tree.
#
# drizzle records an applied migration by the SHA-256 of the file's raw bytes,
# so a checkout that rewrites LF to CRLF (the default under
# `core.autocrlf=true` on Windows) changes every hash and makes `db:migrate`
# treat already-applied migrations as pending. Re-running them fails on the
# first `CREATE TABLE`/`CREATE POLICY` that already exists.
*.sql text eol=lf

# Shell scripts and node CLIs run on the Linux deployment server. A CRLF
# checkout makes the kernel read the shebang as `/usr/bin/env bash\r`, and the
# very first command fails with "bad interpreter: No such file or directory" —
# on the server, during install, with no obvious cause. Same for the `#!/usr/bin/env
# node` scripts. Force LF regardless of the developer's platform.
*.sh  text eol=lf
*.mjs text eol=lf
