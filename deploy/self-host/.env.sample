# =============================================================================
# Supabase self-host — environment for the trimmed docker-compose.yml
#
# Copy to `.env` in the same folder, then:
#   • paste the secret values from `node generate-secrets.mjs` (block 1)
#   • replace 10.0.0.5 with this server's real ministry-LAN IP
#
# The `app` service in the compose file reads from this same file, so the app's
# secrets live here too — there is no separate .env.local on the server.
# =============================================================================

############ Secrets — fill from generate-secrets.mjs ############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
CRON_SECRET=

# Encrypts connection strings that Studio stores through postgres-meta.
PG_META_CRYPTO_KEY=

############ Database ############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Port Postgres is published on to the host. Only change this if the host
# already runs its own Postgres on 5432 — it does not affect anything inside
# the compose network.
POSTGRES_PUBLISHED_PORT=5432

############ JWT ############
JWT_EXPIRY=3600

############ URLs — MUST be the server's LAN IP, not localhost ############
# The browser talks to Supabase directly, so localhost would break other PCs.
SITE_URL=http://10.0.0.5:3000
API_EXTERNAL_URL=http://10.0.0.5:8000
SUPABASE_PUBLIC_URL=http://10.0.0.5:8000
ADDITIONAL_REDIRECT_URLS=http://10.0.0.5:3000

############ Auth — email flows OFF ############
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

############ Kong (the single public entrypoint, port 8000) ############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############ PostgREST ############
PGRST_DB_SCHEMAS=public,storage

############ Studio / imgproxy ############
STUDIO_DEFAULT_ORGANIZATION=Ministry
STUDIO_DEFAULT_PROJECT=Registry
IMGPROXY_AUTO_WEBP=true

############ New-style opaque API keys — intentionally EMPTY ############
# Supabase is migrating from HS256 JWT keys (what generate-secrets.mjs makes)
# to opaque `sb_…` keys. Leaving these blank makes Kong's entrypoint fall back
# to the legacy path, which is what this stack uses. Do not invent values.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

############ The app (compose profile `app`) ############
# Tag of the image you built and loaded onto this server. Keep it versioned in
# real deployments (registry-app:2026-08-17) so a rollback is one edit here.
APP_IMAGE=registry-app:latest

# LAN port the app is published on. Must match the port in SITE_URL above.
APP_PORT=3000

SUPABASE_STORAGE_BUCKET=private
TERM_END_NOTICE_DAYS=10
